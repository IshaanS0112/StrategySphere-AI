# Copy to backend/.env for local (non-Docker) runs.
DATABASE_URL=postgresql+psycopg2://strategy:strategy@localhost:5432/strategysphere

# Optional. Without it, strategy reports fall back to the deterministic
# template - every number is identical, only the prose is missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Path to a JSON table of industry benchmark figures. V3 ships one built from
# SEC XBRL filings; the path is relative to the process working directory, so
# from backend/ that is one level up. Leave empty to fall back to V1's built-in
# ILLUSTRATIVE PLACEHOLDER bands. Supplying competitor financial_data is still
# the better path: the engine then benchmarks against the peer-set median and
# never consults this table at all.
INDUSTRY_BENCHMARKS_PATH=../data/benchmarks/edgar_CY2024.json

# --- SEC EDGAR (only needed to REBUILD the benchmark table) -----------------
# REQUIRED to make any EDGAR request, with no default. SEC guidance is that
# automated access declares who is making it and how to reach them. The client
# raises on construction when this is unset or carries no contact address.
EDGAR_USER_AGENT=
# Published ceiling is 10/second. Settings refuses to load above it.
EDGAR_REQUESTS_PER_SECOND=5
EDGAR_CACHE_DIR=../data/edgar_cache
# Serve cached responses only; a miss is an error, never a silent fetch.
EDGAR_OFFLINE=false
# A sector median is published only at or above this many companies.
EDGAR_MIN_SECTOR_N=20
EDGAR_SIC_LOOKUP_LIMIT=600

# How target_margin_pct is interpreted by the cost-plus anchor.
#   MARGIN -> price = cost / (1 - m)   (realised margin = m)      [correct]
#   MARKUP -> price = cost * (1 + m)   (realised margin = m/(1+m))
PRICING_DEFAULT_MARGIN_BASIS=MARGIN

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
